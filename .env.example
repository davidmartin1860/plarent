# Copy this file to .env and adjust as needed for local development.
# `docker compose` automatically reads a .env file in this directory.

# --- PostgreSQL ---
POSTGRES_DB=plarent
POSTGRES_USER=plarent
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Web (Next.js) ---
WEB_PORT=3000
# Server-side base URL the Next.js server uses to reach the API.
# Inside `docker compose` this must be the service name (http://backend:8080/api).
# When running `npm run dev` on the host (outside Docker) use http://localhost:8080/api.
API_URL=http://backend:8080/api
